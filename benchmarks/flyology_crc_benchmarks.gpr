with "../flyology_crc.gpr";
with "flyology_bench.gpr";

project Flyology_CRC_Benchmarks is
   Oracle_Library :=
     Project'Project_Dir & "../oracle/rust/target/release/libflyology_crc_fast_oracle.a";
   Oracle_System_Libraries :=
     external_as_list ("FLYOLOGY_CRC_ORACLE_SYSTEM_LIBRARIES", " ");

   for Source_Dirs use ("src", "../oracle/ada");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("flyology_crc_comparison.adb");
   for Create_Missing_Dirs use "True";

   package Compiler is
      for Default_Switches ("Ada") use
        ("-O3", "-gnat2022", "-gnatwa", "-gnatwJ", "-gnatVa", "-gnatyM110");
   end Compiler;

   package Linker is
      for Switches ("flyology_crc_comparison.adb") use
        (Oracle_Library) & Oracle_System_Libraries;
   end Linker;
end Flyology_CRC_Benchmarks;
