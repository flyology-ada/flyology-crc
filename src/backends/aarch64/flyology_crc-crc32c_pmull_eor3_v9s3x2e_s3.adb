      Iterations  : in out Count;
      CRC0        : in out U32;
      CRC1        : in out U32;
      CRC2        : in out U32;
      K           : Vector;
      X           : in out Accumulator_Array) is
   begin
      --  Keep the nine fold accumulators and all three scalar CRC streams in
      --  registers for the complete pinned 192-byte loop.  The post-indexed
      --  loads are its exact 9-vector/6-word input geometry.
