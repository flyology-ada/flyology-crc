           "crc32cx %w5, %w5, x9" & ASCII.LF & ASCII.HT &
           "crc32cx %w6, %w6, x11" & ASCII.LF & ASCII.HT &
           "crc32cx %w7, %w7, x13" & ASCII.LF & ASCII.HT &
           "crc32cx %w5, %w5, x10" & ASCII.LF & ASCII.HT &
           "crc32cx %w6, %w6, x12" & ASCII.LF & ASCII.HT &
           "crc32cx %w7, %w7, x14" & ASCII.LF & ASCII.HT &
           "subs %x4, %x4, #1" & ASCII.LF & ASCII.HT &
           "b.ne 1b" & ASCII.LF & ASCII.HT &
           "stp q0, q1, [%x8]" & ASCII.LF & ASCII.HT &
           "stp q2, q3, [%x8, #32]" & ASCII.LF & ASCII.HT &
           "stp q4, q5, [%x8, #64]" & ASCII.LF & ASCII.HT &
           "stp q6, q7, [%x8, #96]" & ASCII.LF & ASCII.HT &
           "str q8, [%x8, #128]",
         Outputs =>
           [System.Address'Asm_Output ("+&r", Vector_Ptr),
            System.Address'Asm_Output ("+&r", Stream0_Ptr),
            System.Address'Asm_Output ("+&r", Stream1_Ptr),
            System.Address'Asm_Output ("+&r", Stream2_Ptr),
            Count'Asm_Output ("+&r", Iterations),
            U32'Asm_Output ("+&r", CRC0),
            U32'Asm_Output ("+&r", CRC1),
            U32'Asm_Output ("+&r", CRC2)],
         Inputs   =>
           [System.Address'Asm_Input ("r", X'Address),
            System.Address'Asm_Input ("r", K'Address)],
         Clobber  =>
           "cc,memory,x9,x10,x11,x12,x13,x14," &
           "v0,v1,v2,v3,v4,v5,v6,v7,v8,v9,v10,v11,v12",
         Volatile => True);
   end Fold_192_Loop;
   pragma Inline_Always (Fold_192_Loop);

   function CLMUL_Scalar (Left, Right : U32) return Vector is
      Result : Vector;
      A      : Vector;
      B      : Vector;
   begin
      Asm
        (Template =>
           "movi %1.2d, #0" & ASCII.LF & ASCII.HT &
           "movi %2.2d, #0" & ASCII.LF & ASCII.HT &
           "ins %1.s[0], %w3" & ASCII.LF & ASCII.HT &
           "ins %2.s[0], %w4" & ASCII.LF & ASCII.HT &
           "pmull %0.1q, %1.1d, %2.1d",
         Outputs =>
           [Vector'Asm_Output ("=&w", Result),
            Vector'Asm_Output ("=&w", A),
            Vector'Asm_Output ("=&w", B)],
         Inputs  =>
           [U32'Asm_Input ("r", Left),
            U32'Asm_Input ("r", Right)]);
      return Result;
   end CLMUL_Scalar;
   pragma Inline_Always (CLMUL_Scalar);

   function Packed_Byte_Square (Item : U32) return U64 is
      Result  : U64;
      Input   : Vector;
      Squared : Vector;
   begin
      --  VMULL.P8 squares the eight polynomial bytes independently. Item
      --  occupies the first four bytes, so the low
      --  64-bit result is exactly the carry-less square of the 32-bit Item.
      Asm
        (Template =>
           "movi %1.2d, #0" & ASCII.LF & ASCII.HT &
           "ins %1.s[0], %w3" & ASCII.LF & ASCII.HT &
           "pmull %2.8h, %1.8b, %1.8b" & ASCII.LF & ASCII.HT &
           "umov %x0, %2.d[0]",
         Outputs =>
           [U64'Asm_Output ("=r", Result),
            Vector'Asm_Output ("=&w", Input),
            Vector'Asm_Output ("=&w", Squared)],
         Inputs  => U32'Asm_Input ("r", Item));
      return Result;
   end Packed_Byte_Square;
   pragma Inline_Always (Packed_Byte_Square);

   function CRC32C_Byte (CRC, Item : U32) return U32 is
      Result : U32;
   begin
      Asm
        (Template => "crc32cb %w0, %w1, %w2",
         Outputs  => U32'Asm_Output ("=r", Result),
         Inputs   =>
           [U32'Asm_Input ("r", CRC),
            U32'Asm_Input ("r", Item)]);
      return Result;
   end CRC32C_Byte;
   pragma Inline_Always (CRC32C_Byte);

   function CRC32C_32 (CRC, Item : U32) return U32 is
      Result : U32;
   begin
      Asm
        (Template => "crc32cw %w0, %w1, %w2",
         Outputs  => U32'Asm_Output ("=r", Result),
         Inputs   =>
           [U32'Asm_Input ("r", CRC),
            U32'Asm_Input ("r", Item)]);
      return Result;
   end CRC32C_32;
   pragma Inline_Always (CRC32C_32);

   function CRC32C_64 (CRC : U32; Item : U64) return U32 is
      Result : U32;
   begin
      Asm
        (Template => "crc32cx %w0, %w1, %x2",
         Outputs  => U32'Asm_Output ("=r", Result),
         Inputs   =>
           [U32'Asm_Input ("r", CRC),
            U64'Asm_Input ("r", Item)]);
      return Result;
   end CRC32C_64;
   pragma Inline_Always (CRC32C_64);

   function XNModP (Exponent : U64) return U32 is
      N       : U64 := Exponent;
      Stack   : U64 := not U64 (1);
      Acc     : U32;
      Low_Bit : U32;
   begin
      while N > 191 loop
         Stack := Interfaces.Shift_Left (Stack, 1) + (N and 1);
         N := Interfaces.Shift_Right (N, 1) - 16;
      end loop;
      Stack := not Stack;
      Acc := Interfaces.Shift_Right (16#8000_0000#, Natural (N and 31));
      N := Interfaces.Shift_Right (N, 5);

      while N > 0 loop
         Acc := CRC32C_32 (Acc, 0);
         N := N - 1;
      end loop;

      loop
         Low_Bit := U32 (Stack and 1);
         Stack := Interfaces.Shift_Right (Stack, 1);
         exit when Stack = 0;
         Acc :=
           CRC32C_64
             (0,
              Interfaces.Shift_Left
                (Packed_Byte_Square (Acc), Natural (Low_Bit)));
      end loop;
      return Acc;
   end XNModP;
   pragma Inline_Always (XNModP);

   function CRC_Shift (CRC : U32; Byte_Length : Count) return Vector is
      Exponent : constant U64 := U64 (Byte_Length) * 8 - 33;
   begin
      return CLMUL_Scalar (CRC, XNModP (Exponent));
   end CRC_Shift;
   pragma Inline_Always (CRC_Shift);

   function Update
     (State : U32;
      Data  : Byte_Array) return U32 is
      CRC0       : U32 := State;
      CRC1       : U32 := 0;
      CRC2       : U32 := 0;
      Pointer    : System.Address := Data'Address;
      Vector_Ptr : System.Address;
      Initial_Vector_Ptr : System.Address;
      Stream1_Ptr : System.Address;
      Stream2_Ptr : System.Address;
      Remaining  : Count := Count (Data'Length);
      Blocks     : Count;
      Iterations : Count;
      KLen       : Count;
      K          : Vector;
      VC0        : Vector;
      VC1        : Vector;
      VC2        : Vector;
      VC         : U64;
      X          : Accumulator_Array;
   begin
      if Remaining = 0 then
         return CRC0;
      end if;

      while Remaining > 0 and then Alignment (Pointer, 8) /= 0 loop
         CRC0 := CRC32C_Byte (CRC0, Load_Byte (Pointer));
         Pointer := Next (Pointer, 1);
         Remaining := Remaining - 1;
      end loop;

      if Alignment (Pointer, 16) /= 0 and then Remaining >= 8 then
         CRC0 := CRC32C_64 (CRC0, Load_64 (Pointer));
         Pointer := Next (Pointer, 8);
         Remaining := Remaining - 8;
      end if;

      if Remaining >= 192 then
         Blocks := Remaining / 192;
         KLen := Blocks * 16;
         Vector_Ptr := Next (Pointer, KLen * 3);
         Initial_Vector_Ptr := Vector_Ptr;

         Vector_Ptr := Next (Vector_Ptr, 144);

         --  Exact pinned v9s3x2e_s3 nine-stream fold key pair.
         K := Pair (16#0000_0000_7E90_8048#, 16#0000_0000_C96C_FDC0#);
         Iterations := Blocks - 1;
         Stream1_Ptr := Next (Pointer, KLen);
         Stream2_Ptr := Next (Pointer, KLen * 2);
         if Iterations > 0 then
            Fold_192_Loop
              (Vector_Ptr, Pointer, Stream1_Ptr, Stream2_Ptr,
               Iterations, CRC0, CRC1, CRC2, K, X);
         else
            X (0) := Load_128 (Initial_Vector_Ptr);
            X (1) := Load_128 (Next (Initial_Vector_Ptr, 16));
            X (2) := Load_128 (Next (Initial_Vector_Ptr, 32));
            X (3) := Load_128 (Next (Initial_Vector_Ptr, 48));
            X (4) := Load_128 (Next (Initial_Vector_Ptr, 64));
            X (5) := Load_128 (Next (Initial_Vector_Ptr, 80));
            X (6) := Load_128 (Next (Initial_Vector_Ptr, 96));
            X (7) := Load_128 (Next (Initial_Vector_Ptr, 112));
            X (8) := Load_128 (Next (Initial_Vector_Ptr, 128));
         end if;

         --  Exact pinned pairwise, four-lane, and final reduction keys.
         K := Pair (16#0000_0000_F20C_0DFE#, 16#0000_0000_493C_7D27#);
         Fold_EOR3 (X (0), K, X (1));
         X (1) := X (2);
         X (2) := X (3);
         X (3) := X (4);
         X (4) := X (5);
         X (5) := X (6);
         X (6) := X (7);
         X (7) := X (8);

         Fold_EOR3 (X (0), K, X (1));
         Fold_EOR3 (X (2), K, X (3));
         Fold_EOR3 (X (4), K, X (5));
         Fold_EOR3 (X (6), K, X (7));

         K := Pair (16#0000_0000_3DA6_D0CB#, 16#0000_0000_BA4F_C28E#);
         Fold_EOR3 (X (0), K, X (2));
         Fold_EOR3 (X (4), K, X (6));

         K := Pair (16#0000_0000_740E_EF02#, 16#0000_0000_9E4A_DDF8#);
         Fold_EOR3 (X (0), K, X (4));

         CRC0 := CRC32C_64 (CRC0, Load_64 (Pointer));
         CRC1 := CRC32C_64 (CRC1, Load_64 (Next (Pointer, KLen)));
         CRC2 := CRC32C_64 (CRC2, Load_64 (Next (Pointer, KLen * 2)));
         CRC0 := CRC32C_64 (CRC0, Load_64 (Next (Pointer, 8)));
         CRC1 := CRC32C_64 (CRC1, Load_64 (Next (Pointer, KLen + 8)));
         CRC2 := CRC32C_64 (CRC2, Load_64 (Next (Pointer, KLen * 2 + 8)));

         VC0 := CRC_Shift (CRC0, KLen * 2 + Blocks * 144);
         VC1 := CRC_Shift (CRC1, KLen + Blocks * 144);
         VC2 := CRC_Shift (CRC2, Blocks * 144);
         VC := Low_Lane (EOR3 (VC0, VC1, VC2));

         CRC0 := CRC32C_64 (0, Low_Lane (X (0)));
         CRC0 := CRC32C_64 (CRC0, VC xor High_Lane (X (0)));

         Pointer := Vector_Ptr;
         Remaining := Remaining mod 192;
      end if;

      if Remaining >= 32 then
         KLen := ((Remaining - 8) / 24) * 8;
         CRC1 := 0;
         CRC2 := 0;
         loop
            CRC0 := CRC32C_64 (CRC0, Load_64 (Pointer));
            CRC1 := CRC32C_64 (CRC1, Load_64 (Next (Pointer, KLen)));
            CRC2 := CRC32C_64 (CRC2, Load_64 (Next (Pointer, KLen * 2)));
            Pointer := Next (Pointer, 8);
            Remaining := Remaining - 24;
            exit when Remaining < 32;
         end loop;

         VC0 := CRC_Shift (CRC0, KLen * 2 + 8);
         VC1 := CRC_Shift (CRC1, KLen + 8);
         VC := Low_Lane (Xor_128 (VC0, VC1));

         Pointer := Next (Pointer, KLen * 2);
         CRC0 := CRC32C_64 (CRC2, Load_64 (Pointer) xor VC);
         Pointer := Next (Pointer, 8);
         Remaining := Remaining - 8;
      end if;

      while Remaining >= 8 loop
         CRC0 := CRC32C_64 (CRC0, Load_64 (Pointer));
         Pointer := Next (Pointer, 8);
         Remaining := Remaining - 8;
      end loop;

      while Remaining > 0 loop
         CRC0 := CRC32C_Byte (CRC0, Load_Byte (Pointer));
         Pointer := Next (Pointer, 1);
         Remaining := Remaining - 1;
      end loop;

      return CRC0;
   end Update;
end Flyology_CRC.CRC32C_PMULL_EOR3_V9S3X2E_S3;
